# Copy to .env in the project root. Real environment variables override values in .env.

# Database: DATABASE_URL wins; otherwise it is built from the POSTGRES_* values.
DATABASE_URL=postgresql://localhost:5432/groundtruth
# POSTGRES_USER=your_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=groundtruth

# If PostgreSQL is unreachable at startup: true = run on SQLite in a reported degraded mode (keyword
# retrieval, no vectors); false = refuse to start.
ALLOW_SQLITE_FALLBACK=true

# LLM judge (Ollama). USE_LLM=false always uses the deterministic rule engine.
USE_LLM=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=35
LLM_TEMPERATURE=0
LLM_SEED=42

# Chunking (tokens of the embedding model's tokenizer; must stay below 254)
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
